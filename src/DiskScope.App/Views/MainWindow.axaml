<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiskScope.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="DiskScope.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DiskScope"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

	<Grid ColumnDefinitions="220,*">
		<!-- Nav Bar -->
		<Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">

			<StackPanel Spacing="0">
				<Border Padding="20,22">
					<TextBlock Text="DiskScope" FontSize="20" FontWeight="SemiBold" Foreground="#172033"></TextBlock>
				</Border>

				<TextBlock Text="ANALYSIS" Margin="16,20,16,8" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"></TextBlock>
				
				<!-- Nav Items -->
				<Border Background="#DBEAFE" CornerRadius="6" Margin="8,2" Padding="10,9">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="◫" Foreground="#2563EB" FontSize="16"></TextBlock>
						<TextBlock Text="Overview" Foreground="#2563EB" FontWeight="SemiBold"></TextBlock>
					</StackPanel>
				</Border>

				<TextBlock Text="Drives" Margin="28,12,16,12" Foreground="#64748B"></TextBlock>
				<TextBlock Text="Directory Explorer" Margin="28,12,16,12" Foreground="#64748B"></TextBlock>
				<TextBlock Text="Large Files" Margin="28,12,16,12" Foreground="#64748B"></TextBlock>
				<TextBlock Text="File Types" Margin="28,12,16,12" Foreground="#64748B"></TextBlock>
				<TextBlock Text="Duplicates" Margin="28,12,16,12" Foreground="#64748B"></TextBlock>

				<Border VerticalAlignment="Bottom" Height="1" Background="#E2E8F0" Margin="16,20"></Border>
			</StackPanel>
			
		</Border>

		<Grid Grid.Column="1" Background="#F7F8FA">
			<StackPanel Margin="32" Spacing="20">
				<StackPanel Spacing="4">
					<TextBlock Text="Overview" FontSize="24" FontWeight="SemiBold" Foreground="#172033"></TextBlock>

					<TextBlock Text="View and analyse your storage." FontSize="13" Foreground="#64748B"></TextBlock>
				</StackPanel>

				<Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
					<StackPanel Spacing="8">
						<TextBlock Text="No drive selected" FontSize="15" FontWeight="SemiBold" Foreground="#172033"></TextBlock>
						<TextBlock Text="Select a drive to start analysing its storage." FontSize="13" Foreground="#64748B"></TextBlock>
					</StackPanel>
				</Border>
			</StackPanel>
		</Grid>
	</Grid>
    
</Window>
